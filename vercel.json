{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://pixelisolate-backend.onrender.com/api/$1" },
    { "source": "/privacy.html", "destination": "/privacy.html" },
    { "source": "/terms.html", "destination": "/terms.html" },
    { "source": "/refund.html", "destination": "/refund.html" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/blog/(.*)", "destination": "/blog/$1/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
