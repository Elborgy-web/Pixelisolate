{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/privacy.html", "destination": "/privacy", "permanent": true },
    { "source": "/terms.html", "destination": "/terms", "permanent": true },
    { "source": "/refund.html", "destination": "/refund", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://pixelisolate-backend.onrender.com/api/$1" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/refund", "destination": "/refund/index.html" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/llms.txt", "destination": "/llms.txt" },
    { "source": "/llms-full.txt", "destination": "/llms-full.txt" },
    { "source": "/blog", "destination": "https://pixelisolate-backend.onrender.com/blog" },
    { "source": "/blog/(.*)", "destination": "https://pixelisolate-backend.onrender.com/blog/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
